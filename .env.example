# Copy to .env for local development. Never commit .env.
APP_ENV=dev
APP_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql://jsk:jsk@localhost:5432/jsk_dev
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
OWNER_EMAIL=
# Not needed in dev: emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=Jobsearch Kit <login@mail.almoti.com>
UI_LOCALE=ru
# Chat model (decision 0009).
AGENT_MODEL=claude-sonnet-5-5
# Google OAuth client (decisions 0008, 0012); redirect URI = APP_BASE_URL + /google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
